# Database URL (для локального запуска)
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/ainews

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
PROXY =

# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
